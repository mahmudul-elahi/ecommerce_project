# ==============================================================================
# Root .gitignore for OmniShop (Laravel 12 API + Next.js 16 Storefront)
# ==============================================================================

# Operating System & Cache
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# IDEs & Developer Tools
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.zed/
.fleet/
.cursor/
.codex/
.phpactor.json
_ide_helper.php
Homestead.json
Homestead.yaml

# Node & Next.js
node_modules/
*/node_modules/
.next/
*/.next/
out/
dist/
dist-ssr/
build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# PHP & Composer
vendor/
*/vendor/
.phpunit.cache/
.phpunit.result.cache
*.log

# Laravel Storage & Framework Caches
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitkeep
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitkeep
backend/storage/framework/cache/locks/*
!backend/storage/framework/cache/locks/.gitkeep
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitkeep
backend/storage/framework/views/*
!backend/storage/framework/views/.gitkeep
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitkeep
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/storage/app/private/*
!backend/storage/app/private/.gitkeep
backend/storage/app/public/*
!backend/storage/app/public/.gitkeep
backend/storage/*.key
backend/storage/pail
backend/public/build
backend/public/hot
backend/public/storage
backend/public/fonts-manifest.dev.json

# SQLite Databases
*.sqlite
*.sqlite-journal
*.sqlite3
backend/database/*.sqlite
backend/database/*.sqlite-journal

# Environment Configs (preserve .env.example)
.env
.env.backup
.env.production
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
backend/.env
backend/.env.backup
backend/.env.production
!*.example
!**/.env.example
